{
  "name": "pico-assistant",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@11.2.2",
  "bin": {
    "pico": "dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:daily": "node scripts/daily-assistant.mjs",
    "test:family:local": "node scripts/check-family-local.mjs --run",
    "test:memory:live": "node scripts/validate-memory.mjs",
    "test:memory:stress": "node --max-old-space-size=128 scripts/stress-memory.mjs",
    "start": "node dist/cli.js",
    "dev": "pnpm build && node dist/cli.js --instance \"$HOME/.local/share/pico-dev\" chat",
    "dev:workspace": "bash scripts/dev.sh workspace",
    "dev:up": "bash scripts/dev.sh up",
    "dev:refresh": "bash scripts/dev.sh refresh",
    "dev:daemon": "bash scripts/dev.sh daemon",
    "dev:tui": "bash scripts/dev.sh tui",
    "dev:status": "bash scripts/dev.sh status",
    "dev:verify": "bash scripts/dev.sh verify"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@firecrawl/anydoc": "0.2.4",
    "@huggingface/transformers": "4.3.1",
    "@mozilla/readability": "0.6.0",
    "@tobilu/qmd": "2.8.3",
    "adm-zip": "0.6.1",
    "cron-parser": "5.10.2",
    "grammy": "1.46.0",
    "jsdom": "30.1.3",
    "mem0ai": "3.3.1",
    "pdfjs-dist": "6.4.299",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typebox": "1.3.37",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
